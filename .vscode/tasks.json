{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Run SHADOW: Full Stack (All Services)",
      "dependsOn": ["Run Backend (FastAPI)", "Run Frontend (Vite)", "Run Telemetry Simulator"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Backend (FastAPI)",
      "type": "shell",
      "command": ".\\venv\\Scripts\\python.exe -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "shadow-stack",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1 --port 5173",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "shadow-stack",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Telemetry Simulator",
      "type": "shell",
      "command": ".\\venv\\Scripts\\python.exe simulator.py",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "shadow-stack",
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
